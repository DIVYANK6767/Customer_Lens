table _Measures
	lineageTag: d14cbfae-2aaa-4715-a9a8-05ea232fde7a

	/// Total gross monetary turnover generated across all completed transactions.
	measure 'Total Revenue' = SUM('Fact_Transactions'[Revenue])
		formatString: £#,##0.00
		displayFolder: 1. Financial & Volume
		lineageTag: 0f856bee-bd09-4543-9454-aa31fe5a75c6

	/// Total distinct active customer accounts with at least one completed transaction in the current filter context.
	measure 'Total Customers' = DISTINCTCOUNT('Fact_Transactions'[CustomerID])
		formatString: #,##0
		displayFolder: 2. Customer & Orders
		lineageTag: 39ba2e97-95b3-4a7d-94ec-6d08dc45ce7b

	/// Total distinct completed commercial transactions (invoices).
	measure 'Total Orders' = DISTINCTCOUNT('Fact_Transactions'[InvoiceNo])
		formatString: #,##0
		displayFolder: 2. Customer & Orders
		lineageTag: 7b0d6593-aaee-4a25-8014-782bec8fd4a4

	/// Average gross turnover generated per completed transaction.
	measure 'Average Order Value' = DIVIDE([Total Revenue], [Total Orders], 0)
		formatString: £#,##0.00
		displayFolder: 1. Financial & Volume
		lineageTag: b2de802c-18e2-4519-8c09-ca5321a62628

	/// Aggregate quantity of physical product units purchased across completed line items.
	measure 'Total Units' = SUM('Fact_Transactions'[Quantity])
		formatString: #,##0
		displayFolder: 1. Financial & Volume
		lineageTag: 3533d481-6e99-4b19-bbc6-fb8582e05aae

	/// Number of distinct customers who have completed 2 or more distinct orders.
	measure 'Repeat Customers' = CALCULATE(COUNTROWS('Dim_Customer'), 'Dim_Customer'[frequency] > 1)
		formatString: #,##0
		displayFolder: 2. Customer & Orders
		lineageTag: 91651d84-d611-4219-a0e5-258df1f2fb85

	/// Number of distinct customers who have completed exactly 1 transaction.
	measure 'One-Time Customers' = [Total Customers] - [Repeat Customers]
		formatString: #,##0
		displayFolder: 2. Customer & Orders
		lineageTag: e66c791a-98d4-4639-a77d-ccb53c474dce

	/// Proportion of active customers who completed more than one transaction.
	measure 'Repeat Customer Rate' = DIVIDE([Repeat Customers], [Total Customers], 0)
		formatString: 0.0%
		displayFolder: 2. Customer & Orders
		lineageTag: baa5a045-161f-4ee9-9c5e-f2d0155a4928

	/// Mean gross turnover generated per active customer account.
	measure 'Revenue per Customer' = DIVIDE([Total Revenue], [Total Customers], 0)
		formatString: £#,##0.00
		displayFolder: 1. Financial & Volume
		lineageTag: 3c0f7009-6ce3-4e8c-8a7c-46e3d7010d93

	/// Mean order velocity per customer across the observation window.
	measure 'Average Orders per Customer' = DIVIDE([Total Orders], [Total Customers], 0)
		formatString: 0.00
		displayFolder: 2. Customer & Orders
		lineageTag: 1f239e17-fe01-4455-b6d0-6a7554635096

	/// Count of customer accounts allocated to the current segment filter context.
	measure 'Segment Customer Count' = COUNTROWS('Dim_Customer')
		formatString: #,##0
		displayFolder: 3. Segmentation & Pareto
		lineageTag: 025ed250-0496-43c7-9dbe-d8233aa947b9

	/// Proportion of the total customer base represented by the selected segment or cohort.
	measure 'Customer Share %' = DIVIDE([Segment Customer Count], CALCULATE([Segment Customer Count], ALL('Dim_Customer')), 0)
		formatString: 0.00%
		displayFolder: 3. Segmentation & Pareto
		lineageTag: 97fa3b86-81a3-4982-b9f5-c4ae6588b7f6

	/// Total gross turnover generated by customers belonging to the active segment context.
	measure 'Segment Revenue' = CALCULATE([Total Revenue], KEEPFILTERS('Dim_Customer'))
		formatString: £#,##0.00
		displayFolder: 3. Segmentation & Pareto
		lineageTag: 1884595a-8306-40f0-bc31-bb8ffd84c1b6

	/// Percentage of total company turnover generated by the selected segment.
	measure 'Segment Revenue %' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALL('Dim_Customer')), 0)
		formatString: 0.00%
		displayFolder: 3. Segmentation & Pareto
		lineageTag: dea7c93d-01e1-4f21-bdcc-980a45552148

	/// Contribution of an individual customer or group to total enterprise gross turnover.
	measure 'Customer Revenue %' = DIVIDE([Total Revenue], CALCULATE([Total Revenue], ALL('Fact_Transactions')), 0)
		formatString: 0.00%
		displayFolder: 3. Segmentation & Pareto
		lineageTag: 2eb026a4-b5ec-4572-a77f-c73532432ac9

	/// Ratio of financial share to customer volume share (% Revenue / % Customers).
	measure 'Revenue Concentration Multiplier' = DIVIDE([Segment Revenue %], [Customer Share %], 0)
		formatString: 0.00
		displayFolder: 3. Segmentation & Pareto
		lineageTag: 45926a17-333d-4795-89a9-a9510ec3d11b

	/// Arithmetic mean days elapsed since last purchase.
	measure 'Average Recency' = AVERAGE('Dim_Customer'[recency])
		formatString: 0.0
		displayFolder: 4. RFM Benchmarks
		lineageTag: a80749ab-57ea-4363-82ee-7a59a87bedc6

	/// Arithmetic mean completed orders per customer.
	measure 'Average Frequency' = AVERAGE('Dim_Customer'[frequency])
		formatString: 0.00
		displayFolder: 4. RFM Benchmarks
		lineageTag: 4382965a-5bfa-4fa4-84d9-24ca15f08650

	/// Arithmetic mean monetary spend per customer.
	measure 'Average Monetary' = AVERAGE('Dim_Customer'[monetary])
		formatString: £#,##0.00
		displayFolder: 4. RFM Benchmarks
		lineageTag: 3b508086-daa3-4723-9c92-c6618b982338

	/// Median days elapsed since last purchase.
	measure 'Median Recency' = MEDIAN('Dim_Customer'[recency])
		formatString: 0.0
		displayFolder: 4. RFM Benchmarks
		lineageTag: ba51be04-8f3f-48d4-8c58-5696f558cab0

	/// Median completed orders per customer.
	measure 'Median Frequency' = MEDIAN('Dim_Customer'[frequency])
		formatString: 0.0
		displayFolder: 4. RFM Benchmarks
		lineageTag: a4aaac92-3c33-43c1-ae81-1cf7ce2511ea

	/// Median gross monetary spend per customer.
	measure 'Median Monetary' = MEDIAN('Dim_Customer'[monetary])
		formatString: £#,##0.00
		displayFolder: 4. RFM Benchmarks
		lineageTag: 5565e4b0-0e20-4020-b358-19ecf41d8397

	column _Placeholder
		isHidden
		lineageTag: 0d56c604-2373-4dfc-95ca-380d18b67ec3
		isNameInferred
		sourceColumn: [_Placeholder]

	partition _Measures = calculated
		mode: import
		source = ROW("_Placeholder", BLANK())

