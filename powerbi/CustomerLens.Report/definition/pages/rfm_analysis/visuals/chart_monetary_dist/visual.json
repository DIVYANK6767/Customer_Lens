{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.1.0/schema.json",
  "name": "chart_monetary_dist",
  "position": {
    "x": 700,
    "y": 230,
    "z": 2100,
    "width": 580,
    "height": 410,
    "tabOrder": 2100
  },
  "visual": {
    "visualType": "areaChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Customer"
                    }
                  },
                  "Property": "monetary"
                }
              },
              "queryRef": "Dim_Customer.monetary",
              "nativeQueryRef": "Customer Spend (£)"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Total Customers"
                }
              },
              "queryRef": "_Measures.Total Customers",
              "nativeQueryRef": "Customers"
            }
          ]
        }
      }
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "logAxisScale": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Customer Monetary Spend Distribution (Log Scale)'"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Observed customer lifetime spend across orders of magnitude (£3.75 to £280k)'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
