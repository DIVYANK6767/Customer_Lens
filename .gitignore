# Power BI temporary files, lock files, and local developer cache
*.tmp.pbix
**/.pbi/

# Data files policy
# 1. Raw dataset: strictly ignored (large 45 MB source file)
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep

# 2. Processed datasets: ignore heavy ETL artifacts; whitelist datasets required by Streamlit
data/processed/*
!data/processed/.gitkeep
!data/processed/customer_transactions.csv
!data/processed/business_segments.csv
!data/processed/segment_summary.csv
!data/processed/clustering_metrics.csv
!data/processed/cluster_profiles.csv
!data/processed/rfm_customer_metrics.csv
!data/processed/marketing_opportunities.csv
!data/processed/customer_clusters.csv

